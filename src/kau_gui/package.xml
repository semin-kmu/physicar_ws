<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kau_gui</name>
  <version>0.2.0</version>
  <description>주행 디버깅 GUI. map + 추종오차 플롯 + 노드 상태를 한 화면에. 관측 전용(read-only)</description>
  <maintainer email="eiffeltower1206@kookmin.ac.kr">Jeon Semin</maintainer>
  <license>Apache-2.0</license>

  <!-- pyqtgraph 는 시스템이 아니라 패키지 안 .venv 에 있다.
       scripts/setup_venv.sh 참고. rosdep 대상이 아니므로 적지 않는다. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- 상태 띠: 감시 토픽 타입을 문자열로 받아 클래스로 푼다 (get_message) -->
  <exec_depend>rosidl_runtime_py</exec_depend>
  <!-- 상태 띠: share/config/bringup.yaml 을 읽어 감시 대상을 정한다.
       코드를 import 하지는 않는다 (경로만 쓴다) -->
  <exec_depend>kau_state_machine</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>kau_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
