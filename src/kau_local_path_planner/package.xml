<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kau_local_path_planner</name>
  <version>0.1.0</version>
  <description>KAU AMET PhysiCar local path planner. reference(global+lane) fusion -> candidate quintic Bezier generation -> obstacle/road/curvature constrained selection -> /path/local</description>
  <maintainer email="team11@physicar.local">KAU AMET Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>kau_msgs</depend>
  <depend>kau_control</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- amet_2026_track.yaml (도로 경계 폴리곤) 을 그대로 재사용한다.
       파일을 복제하지 않고 launch 시점에 그 패키지의 share 경로를 찾는다. -->
  <exec_depend>kau_object_detection</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
