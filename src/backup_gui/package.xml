<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>backup_gui</name>
  <version>0.2.0</version>
  <description>백업 스택 디버깅 GUI. 관측 전용(read-only). 상태머신/측위/맵에 의존하지 않는다.</description>
  <maintainer email="eiffeltower1206@kookmin.ac.kr">Jeon Semin</maintainer>
  <license>Apache-2.0</license>

  <!-- pyqtgraph 는 시스템이 아니라 패키지 안 .venv 에 있다.
       scripts/setup_venv.sh 참고. rosdep 대상이 아니므로 적지 않는다. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- 상태 띠: 감시 토픽 타입을 문자열로 받아 클래스로 푼다 (get_message) -->
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <!-- frames.map/odom 이 base_link 와 다를 때만 import 한다 (기본은 미사용) -->
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>backup_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
