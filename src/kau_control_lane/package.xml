<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kau_control_lane</name>
  <version>0.0.0</version>
  <description>KAU AMET PhysiCar 차선 추종 전용 주행 제어. /lane/center 하나만 보고 lane_speed_controller -> /speed (곡률 기반 목표속도 + PID), lane_steer_controller -> /steering (Pure Pursuit). kau_control 의 대안이며 둘을 동시에 띄우지 않는다</description>
  <maintainer email="physicar@todo.todo">physicar</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>kau_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- /lane/center 발행자. launch 의 lane_detection:=true 일 때만 쓴다 -->
  <exec_depend>kau_lane_detection</exec_depend>
  <!-- /path/local 발행자. launch 의 planner:=true 일 때만 쓴다 -->
  <exec_depend>kau_local_path_planner_lane</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
