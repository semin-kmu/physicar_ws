<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kau_path_arbiter</name>
  <version>0.0.0</version>
  <description>주행 경로 소스 중재. 장애물이 없으면 /lane/center(차선 그 자체)를, 있으면 /path/local(회피 경로)을 골라 /path/drive 하나로 내보낸다. 히스테리시스로 두 소스 사이를 떨지 않는다</description>
  <maintainer email="physicar@todo.todo">physicar</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>kau_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- /lane/center 발행자 -->
  <exec_depend>kau_lane_detection</exec_depend>
  <!-- /path/local 발행자 -->
  <exec_depend>kau_local_path_planner_lane</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
