<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kau_object_detection</name>
  <version>0.1.0</version>
  <description>LiDAR-first object detection for the KAU AMET PhysiCar platform.</description>
  <maintainer email="team11@physicar.local">KAU AMET Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <!-- Object List contract published on /perception/obstacles. -->
  <depend>kau_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Start signal detection. The camera is used for the one-time start
       traffic light only. The compressed payload is decoded with cv::imdecode,
       so OpenCV alone is enough and no cv_bridge is needed. -->
  <depend>std_msgs</depend>
  <depend>libopencv-dev</depend>

  <!-- Read-only Gazebo Transport world pose diagnostics. Optional at build
       time: CMake degrades gracefully when these are absent. -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

