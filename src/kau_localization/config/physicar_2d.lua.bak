--
-- PhysiCar 2D SLAM (mapping) 설정.
--
-- TF 소유권 분리가 이 파일의 핵심이다.
--   odom -> base_footprint : ekf_filter_node (robot_localization) 가 이미 소유
--   map  -> odom           : Cartographer 가 담당 (드리프트 보정량)
-- 따라서 provide_odom_frame 은 반드시 false 여야 한다. true 로 두면
-- Cartographer 가 odom -> base_footprint 까지 발행해 EKF 와 정면 충돌하고,
-- 부모가 둘인 프레임이 생겨 tf2 가 깨진다.
--
-- 센서 실측값 (2026-08 기준)
--   /scan  : lidar_link, 720점 360deg, 0.1~16 m, 10 Hz
--   /odom  : EKF 융합 출력 (/odom/laser ICP + /imu), 30 Hz
--   /imu   : 38 Hz -> Cartographer 직접 입력에는 너무 느리고,
--            어차피 EKF 를 통해 /odom 에 반영되므로 use_imu_data = false.

include "map_builder.lua"
include "trajectory_builder.lua"

options = {
  map_builder = MAP_BUILDER,
  trajectory_builder = TRAJECTORY_BUILDER,

  map_frame = "map",
  -- use_imu_data = false 이므로 tracking_frame 이 imu_link 일 필요가 없다.
  tracking_frame = "base_footprint",
  published_frame = "odom",
  odom_frame = "odom",
  provide_odom_frame = false,          -- EKF 가 odom 을 소유한다
  publish_frame_projected_to_2d = true,

  use_pose_extrapolator = true,
  use_odometry = true,                 -- /odom 을 스캔 매칭 prior 로 사용
  use_nav_sat = false,
  use_landmarks = false,

  num_laser_scans = 1,                 -- /scan 구독을 켠다
  num_multi_echo_laser_scans = 0,
  num_subdivisions_per_laser_scan = 1,
  num_point_clouds = 0,

  lookup_transform_timeout_sec = 0.2,
  submap_publish_period_sec = 0.3,
  pose_publish_period_sec = 5e-3,
  trajectory_publish_period_sec = 30e-3,

  rangefinder_sampling_ratio = 1.,
  odometry_sampling_ratio = 1.,
  fixed_frame_pose_sampling_ratio = 1.,
  imu_sampling_ratio = 1.,
  landmarks_sampling_ratio = 1.,
}

MAP_BUILDER.use_trajectory_builder_2d = true
MAP_BUILDER.num_background_threads = 2       -- 4코어 (Pi 급) 기준. 기본 4는 과다

TRAJECTORY_BUILDER_2D.use_imu_data = false   -- IMU 는 EKF 경유. 이중 계산 방지
TRAJECTORY_BUILDER_2D.min_range = 0.12       -- 차체 자기반사 컷 (센서 range_min 0.1)
TRAJECTORY_BUILDER_2D.max_range = 14.0       -- 센서 range_max 16 m 보다 낮게 잡아야
TRAJECTORY_BUILDER_2D.missing_data_ray_length = 5.0   -- 12~16 m 리턴이 miss 로 전환된다

-- 10 Hz 는 스캔 간 회전량이 커서, ceres 만으로는 초기 추정이 빗나가면 못 따라온다.
TRAJECTORY_BUILDER_2D.use_online_correlative_scan_matching = true
TRAJECTORY_BUILDER_2D.real_time_correlative_scan_matcher.linear_search_window = 0.15
TRAJECTORY_BUILDER_2D.real_time_correlative_scan_matcher.angular_search_window = math.rad(20.)

TRAJECTORY_BUILDER_2D.motion_filter.max_time_seconds = 0.5
TRAJECTORY_BUILDER_2D.motion_filter.max_distance_meters = 0.1
TRAJECTORY_BUILDER_2D.motion_filter.max_angle_radians = math.rad(1.0)

TRAJECTORY_BUILDER_2D.submaps.num_range_data = 45
TRAJECTORY_BUILDER_2D.submaps.grid_options_2d.resolution = 0.05   -- nav2 costmap 과 동일

TRAJECTORY_BUILDER_2D.ceres_scan_matcher.translation_weight = 10.
TRAJECTORY_BUILDER_2D.ceres_scan_matcher.rotation_weight = 40.

POSE_GRAPH.optimize_every_n_nodes = 45
POSE_GRAPH.constraint_builder.sampling_ratio = 0.3
POSE_GRAPH.constraint_builder.min_score = 0.62
POSE_GRAPH.constraint_builder.global_localization_min_score = 0.66
POSE_GRAPH.optimization_problem.huber_scale = 1e1

-- 기본값은 코어 수를 넘겨서 ceres 가
--   "Specified options.num_threads: 7 exceeds maximum available ... 4"
-- 경고를 뿜는다. 명시적으로 묶어둔다.
POSE_GRAPH.constraint_builder.ceres_scan_matcher.ceres_solver_options.num_threads = 1
POSE_GRAPH.optimization_problem.ceres_solver_options.num_threads = 2

return options
